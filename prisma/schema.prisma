generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Serverless functions open a connection per invocation, which exhausts a
  // Postgres server's connection limit fast. DATABASE_URL therefore points at
  // the POOLED endpoint (Neon's `-pooler` host, Supabase's port 6543).
  url = env("DATABASE_URL")
  // Migrations and introspection need a real session, which a transaction
  // pooler cannot give them — so they use the direct endpoint instead.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PLANNER
  MEMBER
}

enum StudioStatus {
  ACTIVE
  SUSPENDED
}

enum WeddingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
  MAYBE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PricePlanKind {
  /** Charged once, when a wedding is published. */
  PER_WEDDING
  MONTHLY
  YEARLY
}

/**
 * Mirrors Stripe's subscription statuses exactly, including the ones we hope
 * never to see. Mapping several of Stripe's states onto one of ours would mean
 * the webhook has to decide what `incomplete_expired` "really" means, and that
 * decision is better made where it is read than where it is written.
 */
enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum TemplateKey {
  BLUSH_ROMANCE
  MODERN_SAGE
  CLASSIC_ELEGANCE
  MIDNIGHT_BLOOM
  PACIFIC_LINEN
  VELVET_BOTANICAL
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

enum PhotoSlot {
  HERO
  COUPLE
  STORY
  GALLERY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  role         Role
  studioId     String?
  studio       Studio?   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  /**
   * The cutoff that makes a JWT session revocable.
   *
   * Sessions are JWTs, which is what makes them fast — no session table read on
   * every request. It is also what makes them impossible to revoke: a signed
   * token stays valid until it expires no matter what happens to the account
   * behind it. Before this column, resetting a password did not sign anyone out.
   * An attacker holding a stolen session kept it, which is the exact scenario a
   * password reset is performed to end.
   *
   * So every token records when it was issued, and this column records the
   * moment tokens stopped being trusted. The `jwt` callback compares the two and
   * drops anything older. Bumping this is what "sign out everywhere" means, and
   * it is done on password reset, on an admin-issued password, and on any change
   * to role or studio — because those are baked into the token and would
   * otherwise stay stale for the life of it.
   *
   * Nullable: a row that predates this column has never been revoked, which is
   * the correct reading, and treating null as "revoke everything" would sign out
   * every existing user at deploy for no reason.
   */
  sessionsValidFrom DateTime?
  createdAt    DateTime  @default(now())
  resetTokens  PasswordResetToken[]
  tickets      SupportTicket[]

  @@index([studioId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Studio {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  status           StudioStatus @default(ACTIVE)
  /**
   * The studio's logo: a resolved public URL, plus the storage prefix behind it
   * and the intrinsic pixel size of the largest derivative.
   *
   * The URL is denormalised deliberately. A logo is rendered in the sidebar of
   * every studio page, in the footer of every published wedding site and in the
   * header of every email — and email in particular cannot call a resolver, it
   * needs an absolute URL baked into the HTML at send time. Storing the derived
   * URL keeps all three paths identical and removes a `storage()` call from
   * hot render paths. `logoKey` is what makes the object deletable; a URL alone
   * would strand the derivatives on replacement.
   *
   * Width and height exist so every `<img>` can be given real dimensions. A
   * logo above the fold with no intrinsic size is a guaranteed layout shift.
   */
  logoUrl          String?
  logoKey          String?
  logoWidth        Int?
  logoHeight       Int?
  /**
   * Which typeface the studio's own name is set in — see lib/branding.ts.
   *
   * A validated String rather than a Prisma enum, and that is the one place
   * this model departs from the house style. Adding a value to a Postgres enum
   * is a migration that cannot run inside the same transaction as anything
   * using the new value, so shipping a seventh typeface would mean a two-step
   * deploy. A brand style is presentation, chosen from a list that will grow;
   * it does not warrant that. The set is enforced by `zStudioBranding`, and an
   * unrecognised value falls back to CLASSIC rather than breaking a render.
   */
  brandFont        String       @default("CLASSIC")
  brandColor       String       @default("#9D5C64")
  website          String?
  instagram        String?
  contactEmail     String?
  contactPhone     String?
  stripeCustomerId String?      @unique
  freeWeddingUsed  Boolean      @default(false)
  users            User[]
  weddings         Wedding[]
  payments         Payment[]
  tickets          SupportTicket[]
  /** Per-studio price overrides. Empty for a studio on the platform defaults. */
  pricePlans       PricePlan[]
  subscription     Subscription?
  createdAt        DateTime     @default(now())
}

model Wedding {
  id          String         @id @default(cuid())
  studioId    String
  studio      Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  slug        String         @unique
  template    TemplateKey
  status      WeddingStatus  @default(DRAFT)
  partnerOne  String
  partnerTwo  String
  date        DateTime
  venue       String?
  city        String?
  /** Full street address of the main venue. Feeds the map links. */
  venueAddress String?
  /** Optional; when present the map opens on the exact pin rather than a search. */
  venueLat    Float?
  venueLng    Float?
  /**
   * IANA zone of the venue, e.g. "Europe/Rome". Every event time is entered as
   * local wall time here and stored as the UTC instant it corresponds to, so
   * calendars are correct for guests wherever they open them.
   */
  timeZone    String         @default("UTC")
  story       String?        @db.Text
  // Travel details, written by the planner. All optional; the Travel section
  // hides itself when every one of them is empty rather than inventing copy.
  venueNote     String? @db.Text
  accommodation String? @db.Text
  travelNote    String? @db.Text
  // Enabled optional sections, e.g. ["COUNTDOWN","TRAVEL","FAQ","REGISTRY","CASH","GALLERY"]
  sections    String[]       @default(["COUNTDOWN", "TRAVEL", "FAQ", "REGISTRY", "CASH", "GALLERY"])
  guests      Guest[]
  events      Event[]
  faqs        Faq[]
  registry    RegistryItem[]
  funds       CashFund[]
  photos      Photo[]
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studioId, status])
}

model Guest {
  id         String    @id @default(cuid())
  weddingId  String
  wedding    Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  studioId   String // denormalized for O(1) tenant checks
  name       String
  email      String?
  phone      String?
  /** One seat per event — see the Seat model. */
  seats      Seat[]
  // V1 pragmatic choice: group names as a Postgres text[] on the guest.
  // The join-table version in ARCHITECTURE.md is a straight migration later.
  groups     String[]  @default([])
  inviteCode String    @unique
  invitedAt  DateTime?
  rsvp       Rsvp?
  createdAt  DateTime  @default(now())

  @@index([weddingId])
  @@index([studioId])
}

/**
 * A table, belonging to one event.
 *
 * Seating is per-event, not per-wedding: a ceremony and a cocktail hour have
 * no tables, while a reception dinner and a farewell brunch each have their
 * own, with different people at different tables. An event simply has tables
 * or it does not — no "needs seating" flag to keep in sync with reality.
 *
 * `weddingId` is denormalized alongside `eventId` so the planner page can
 * count across a whole wedding without joining through every event.
 *
 * Shaped for what comes next: `shape` and `capacity` serve a printable chart,
 * normalised 0–1 `x`/`y` (null until placed) serve a floor plan, and
 * `Seat.seatOrder` carries drag-and-drop ordering. Automatic seating needs no
 * schema at all — it reads groups and RSVPs and writes Seat rows.
 */
model Table {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Denormalized scalar, deliberately not a relation: deletion already
  // cascades Wedding -> Event -> Table, and this exists only so wedding-wide
  // queries do not have to join through every event.
  weddingId String
  studioId  String // denormalized for O(1) tenant checks, as on Guest
  name      String
  capacity  Int        @default(8)
  shape     TableShape @default(ROUND)
  note      String?
  /** Normalised floor-plan position, null until placed. */
  x         Float?
  y         Float?
  sortOrder Int        @default(0)
  seats     Seat[]
  createdAt DateTime   @default(now())

  @@index([eventId, sortOrder])
  @@index([weddingId])
  @@index([studioId])
}

/**
 * One guest, at one table, for one event.
 *
 * `eventId` is denormalized from the table purely so the database can hold
 * `@@unique([guestId, eventId])`. That constraint is the whole point: a guest
 * cannot be seated at two tables within the same event, and it is enforced by
 * Postgres rather than by a service check that a future code path could miss.
 * Across different events they are free to sit anywhere.
 */
model Seat {
  id        String   @id @default(cuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId   String // denormalized so the unique constraint below is possible
  studioId  String
  /** Position at the table. Reserved for drag-and-drop ordering. */
  seatOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([guestId, eventId])
  @@index([tableId, seatOrder])
  @@index([studioId])
}

enum TableShape {
  ROUND
  RECTANGLE
  SQUARE
  HEAD
}

model Event {
  id          String   @id @default(cuid())
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  /**
   * `day` and `time` remain the display strings the guest site has always
   * shown — planners write "Late" or "After dinner" and that should survive.
   * They are now generated from startsAt when it is set, and still editable.
   */
  day         String // display day label, e.g. "Saturday, September 25"
  time        String // display time, e.g. "4:00 PM"
  /**
   * The machine-readable instants, stored in UTC.
   *
   * A calendar entry cannot be derived from free text: "7pm" has no date, and
   * "Friday, September 24" has no year or timezone. These are converted from
   * the planner's local wall time using Wedding.timeZone at write time, so a
   * guest in another country is given the right moment rather than the right
   * numbers. Nullable because events created before this existed have no
   * reliable value, and inventing one would put a wedding in the wrong day of
   * somebody's calendar.
   */
  startsAt    DateTime?
  endsAt      DateTime?
  sortKey     Int      @default(0)
  location    String?
  /** Street address for this event, when it differs from the main venue. */
  address     String?
  /** Optional, and only ever used to make a map pin exact. */
  lat         Float?
  lng         Float?
  dressCode   String?
  isPublic    Boolean  @default(false)
  audiences   String[] @default([]) // group names; empty + isPublic=false means nobody sees it
  tables      Table[]

  @@index([weddingId, sortKey])
  @@index([weddingId, startsAt])
}

model Rsvp {
  id          String     @id @default(cuid())
  guestId     String     @unique
  guest       Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status      RsvpStatus
  meal        String?
  dietary     String?
  notes       String?    @db.Text
  respondedAt DateTime   @default(now())
}

model RegistryItem {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title     String
  imageUrl  String?
  price     String?
  retailer  String?
  url       String
  sortOrder Int     @default(0)
  /** Shown in the short teaser on the invitation. Three at most. */
  featured  Boolean @default(false)

  /**
   * Claimed by a guest, on the honour system.
   *
   * There is no payment here and no account: a guest buys from the retailer
   * and comes back to say so. That is how every registry of this kind works,
   * and it is why the planner can always release a claim — a mistyped name or
   * a guest who changed their mind must not permanently retire a gift.
   */
  purchasedBy   String?
  purchasedAt   DateTime?
  purchaseNote  String?   @db.Text

  @@index([weddingId, sortOrder])
  @@index([weddingId, purchasedAt])
}

model CashFund {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  blurb     String?
  venmoUrl  String?
  paypalUrl String?
  stripeUrl String?
  goalCents Int?
}

model Faq {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
}

model Payment {
  id                    String        @id @default(cuid())
  studioId              String
  studio                Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  weddingId             String?
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus
  description           String
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  /** Set for subscription invoices; null for one-time per-wedding charges. */
  stripeInvoiceId       String?       @unique
  /**
   * Which price produced this amount. Nullable because every payment taken
   * before price plans existed has no plan to point at, and backfilling a guess
   * would put a number in the audit trail that nobody actually charged.
   *
   * `amountCents` above stays the authoritative record of what was charged.
   * This is provenance, not a lookup — restrict on delete so a plan that has
   * billed somebody can never be erased out from under its receipts.
   */
  pricePlanId           String?
  pricePlan             PricePlan?    @relation(fields: [pricePlanId], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())

  @@index([studioId, createdAt])
  @@index([pricePlanId])
}

/**
 * One immutable version of one price.
 *
 * Rows here are never updated. Changing a price inserts a new row and archives
 * the old one, which is what makes "changing the default must not change
 * existing subscriptions" a property of the shape rather than a rule someone
 * has to remember: a live subscription holds `pricePlanId`, so it keeps
 * pointing at the row it was sold on no matter what the admin does afterwards.
 *
 * `studioId` null means this is the platform default for its kind; set means it
 * is an override for that one studio. `resolvePrice()` prefers the override.
 */
model PricePlan {
  id            String         @id @default(cuid())
  kind          PricePlanKind
  amountCents   Int
  currency      String         @default("usd")
  /** Null = platform default. Set = an override belonging to this studio. */
  studioId      String?
  studio        Studio?        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  /**
   * The Stripe Price this plan was published as. Null for PER_WEDDING, which
   * uses inline `price_data` because a one-time charge is never reused.
   *
   * Subscriptions cannot work that way: an inline price is archived the moment
   * it is created and can be neither updated nor reused, so a subscription
   * bound to one is invisible in the Dashboard and impossible to migrate.
   */
  stripePriceId String?        @unique
  /**
   * The uniqueness trick that makes "exactly one current price per scope" a
   * database constraint rather than an application convention.
   *
   * Holds `"<kind>:<studioId>"` — or `"<kind>:GLOBAL"` — while this row is the
   * current one, and NULL once it is archived. Postgres treats NULLs in a
   * unique index as distinct, so any number of archived rows coexist happily
   * while two rows can never claim the same live scope.
   *
   * This is a partial unique index expressed in a way Prisma can represent.
   * Writing it as `@@index(...) WHERE active` would be raw SQL the schema
   * cannot describe, and `prisma migrate dev` would then read it as drift and
   * offer to reset the developer's database.
   *
   * Denormalised, and deliberately fail-closed: the only way to get it wrong is
   * to leave it NULL, which hides a price rather than double-charging anyone.
   */
  activeKey     String?        @unique
  createdAt     DateTime       @default(now())
  archivedAt    DateTime?
  /** Who set it, for the audit trail. Free text, same as AuditLog.actorName. */
  createdBy     String?

  payments      Payment[]
  subscriptions Subscription[]

  @@index([kind, studioId])
}

/**
 * A studio's recurring plan, mirrored from Stripe.
 *
 * Stripe is the source of truth for status and period; this row exists so the
 * product can answer "is this studio subscribed" without a network call on
 * every page render. It is written only by the webhook.
 *
 * One per studio. A studio that cancels and later resubscribes overwrites this
 * row — the money history lives in `Payment`, which is append-only.
 */
model Subscription {
  id                   String             @id @default(cuid())
  studioId             String             @unique
  studio               Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  /** The price it was sold on. Unaffected by later changes to the default. */
  pricePlanId          String
  pricePlan            PricePlan          @relation(fields: [pricePlanId], references: [id], onDelete: Restrict)
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}

/**
 * Every Stripe event we have already acted on.
 *
 * Stripe redelivers on any non-2xx and will replay an event days later; a
 * handler that credits a subscription or records a payment must therefore be
 * safe to run twice. Inserting the event id first and letting the unique index
 * reject the replay makes that safety structural, in the same way `runOnce`
 * does for outbound effects.
 */
model ProcessedWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([processedAt])
}

model PlatformSetting {
  id                   Int     @id @default(1)
  /**
   * Superseded by the PER_WEDDING PricePlan, and no longer read anywhere.
   *
   * Kept rather than dropped so the migration that introduced price plans is
   * purely additive and reversible by hand. The migration seeds the first
   * PER_WEDDING plan from whatever value this held, so an admin who had already
   * moved off $99 keeps their number.
   *
   * @deprecated Read `resolvePrice(studioId, "PER_WEDDING")` instead.
   */
  pricePerWeddingCents Int     @default(9900)
  firstWeddingFree     Boolean @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorType String // ADMIN | PLANNER | GUEST | SYSTEM
  actorName String?
  studioId  String?
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([studioId, createdAt])
  @@index([createdAt])
}

/**
 * An uploaded wedding photo.
 *
 * `basePath` is the storage prefix owning every derivative of this photo
 * (e.g. "studios/<sid>/weddings/<wid>/<uuid>"); deleting the row deletes that
 * whole prefix, so there is exactly one place to clean up. `variants` holds the
 * generated ladder as [{ format, width, height, key, bytes }] — written once at
 * upload and read on every render, so the public site never resizes anything.
 * `blurData` is a ~400-byte inline data URI used as the blur-up placeholder.
 */
model Photo {
  id        String    @id @default(cuid())
  weddingId String
  wedding   Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  studioId  String // denormalized for O(1) tenant checks, same as Guest
  slot      PhotoSlot
  basePath  String
  variants  Json
  /**
   * Measurements taken from the photograph at upload time — luminance,
   * saturation, tonal spread, dominant colour and a focal point. The rendering
   * layer derives its scrim strength, desaturation and crop position from
   * these, so the treatment adapts to each image instead of applying one fixed
   * overlay that only suits some of them. Null on photos uploaded before this
   * existed; the renderer falls back to neutral defaults.
   */
  tone      Json?
  blurData  String    @db.Text
  width     Int
  height    Int
  bytes     Int
  alt       String    @default("")
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([weddingId, slot, sortOrder])
  @@index([studioId])
}

// Every outbound email attempt is recorded — nothing fails silently.
model EmailLog {
  id        String      @id @default(cuid())
  studioId  String?
  kind      String // GUEST_INVITATION | RSVP_CONFIRMATION | PLANNER_INVITE | PAYMENT_RECEIPT | PASSWORD_RESET
  toEmail   String
  subject   String
  status    EmailStatus
  provider  String? // resend message id on success
  error     String? // provider error message on failure
  createdAt DateTime    @default(now())

  @@index([studioId, createdAt])
  @@index([status, createdAt])
}

/**
 * A planner asking to be let in.
 *
 * EventOS has no self-serve signup: studios are created by the platform owner,
 * one at a time. That is a deliberate product decision, not a missing feature —
 * but it leaves the public site with nowhere to send anyone. This is that
 * somewhere.
 *
 * Kept entirely separate from User and Studio. Nothing here grants access; a
 * row is a lead until an admin acts on it, at which point the ordinary planner
 * creation path runs and this row is only marked.
 */
model AccessRequest {
  id      String @id @default(cuid())
  name    String
  email   String
  /** Studio or company name. Optional: solo planners often have neither. */
  company String?
  website String?
  /** Free text, kept as a string rather than an enum — the useful answers are
      ranges people describe in their own words ("about 12", "6-8 plus corporate"). */
  volume  String?
  message String?

  status     AccessRequestStatus @default(NEW)
  /** Set when an admin resolves it, so the inbox can show how long it took. */
  reviewedAt DateTime?
  note       String?

  /** Coarse abuse signal only. Never surfaced, never used for analytics. */
  ip        String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([email])
}

enum AccessRequestStatus {
  NEW
  INVITED
  DECLINED
}

/**
 * A record that a side effect has already happened.
 *
 * Sending an invitation is not idempotent by nature: the planner clicks
 * "Send", the function is slow, the browser retries or they click again, and a
 * guest receives the same invitation twice. That is not a data-integrity
 * problem — it is embarrassing, on the one email a couple cares most about.
 *
 * The `key` is derived from what the operation *is* rather than from when it
 * was requested: for an invitation, the guest and the wedding. Two attempts to
 * send the same guest the same invitation therefore collide on the unique
 * index, and the second one loses. The row is claimed *before* the side effect
 * runs, so the race is settled by Postgres rather than by timing.
 *
 * `expiresAt` keeps the table from growing without bound and, more usefully,
 * defines what "again" means: re-sending an invitation next month is a
 * legitimate action, re-sending it four seconds later is a double-click.
 */
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  scope     String
  studioId  String?
  /** Set once the operation completes, so a retry can tell "done" from "in flight". */
  completedAt DateTime?
  /** Provider id or similar, returned to a retry instead of redoing the work. */
  result    Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([scope, studioId])
}

/**
 * Support tickets.
 *
 * A ticket belongs to a studio and to the user who opened it. Both are stored:
 * `studioId` is what every planner-side query filters on — it is the tenant
 * boundary, and it is denormalised onto the ticket for the same reason Guest
 * and Photo carry it, so an ownership check is one indexed column rather than
 * a join. `userId` records who actually wrote it, which matters once a studio
 * has more than one person in it.
 *
 * Both cascade. A deleted studio takes its tickets with it, exactly as it takes
 * its weddings — a support thread about a wedding that no longer exists, owned
 * by a studio that no longer exists, is not a record anyone wants kept.
 *
 * The conversation lives in TicketMessage rather than in a text column on the
 * ticket, so the history is append-only by construction. There is no edit path
 * and no update on a message anywhere in the service: a support thread that can
 * be rewritten after the fact is not a record of what was said.
 */
model SupportTicket {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  /** Who opened it. Kept even in a one-person studio, for when it is not one. */
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject  String
  category TicketCategory
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  messages TicketMessage[]

  /**
   * When the thread last moved, in either direction.
   *
   * Denormalised so the queue can sort by activity without aggregating over
   * every message on every load. `createdAt` answers "how old is this", which
   * is a different and less useful question for a work queue.
   */
  lastMessageAt DateTime @default(now())
  /** Set when an admin first picks it up, so response time is measurable. */
  firstReplyAt  DateTime?
  resolvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /** The planner's own list: their tickets, newest activity first. */
  @@index([studioId, lastMessageAt])
  /** The admin queue: everything at one status, oldest first. */
  @@index([status, createdAt])
  /** A studio's tickets filtered by status, for the planner-side tabs. */
  @@index([studioId, status])
}

/**
 * One message in a thread.
 *
 * `authorType` rather than a nullable userId, because an admin is not a member
 * of the studio and has no row that belongs to it. `authorName` is captured at
 * write time so the thread still reads correctly after a person leaves — a
 * historical record should not change because a row elsewhere did.
 */
model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType TicketAuthor
  /** Display name as it was when the message was written. Never re-resolved. */
  authorName String
  body       String       @db.Text

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_PLANNER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketAuthor {
  PLANNER
  ADMIN
}

/**
 * Deliberately coarse. A category exists to route a ticket to the right first
 * response, not to build a taxonomy — six options someone picks correctly beat
 * twenty they pick at random.
 */
enum TicketCategory {
  GETTING_STARTED
  GUESTS_AND_RSVPS
  WEBSITE_AND_DESIGN
  SCHEDULE_AND_SEATING
  BILLING
  SOMETHING_BROKEN
  OTHER
}

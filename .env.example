# PostgreSQL (Neon, Supabase, RDS, or local)
#
# DATABASE_URL must be the POOLED endpoint in production — serverless functions
# open a connection per invocation and will exhaust a direct connection limit.
#   Neon:     ...-pooler.<region>.aws.neon.tech
#   Supabase: port 6543 (transaction pooler)
# DIRECT_URL is the unpooled endpoint; only `prisma migrate` uses it.
# Locally the two can be identical.
DATABASE_URL="postgresql://user:password@localhost:5432/weddingos"
DIRECT_URL="postgresql://user:password@localhost:5432/weddingos"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# Absolute URL of the app (no trailing slash)
APP_URL="http://localhost:3000"

# Stripe (optional in dev — publishing falls back to a recorded dev payment)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (optional in dev — emails log to console)
RESEND_API_KEY=""
EMAIL_FROM="WeddingOS <no-reply@yourdomain.com>"

# Photo storage — any S3-compatible bucket.
# Leave S3_BUCKET empty in dev and uploads are written to public/uploads instead.
#
#   Cloudflare R2:  S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#                   S3_REGION="auto"
#                   S3_PUBLIC_URL="https://photos.yourdomain.com"   (public bucket or custom domain)
#   AWS S3:         leave S3_ENDPOINT empty, set S3_REGION="us-east-1"
#                   S3_PUBLIC_URL="https://<dist>.cloudfront.net"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_PUBLIC_URL=""

# Upstash Redis — the shared store behind rate limiting.
#
# REQUIRED IN PRODUCTION. The app refuses to boot without both values when
# NODE_ENV=production, and that is deliberate: without them lib/ratelimit falls
# back to a per-process Map, which on serverless means every instance keeps its
# own counters and every limit multiplies by however many are warm. The login
# throttle is the one that matters — credential stuffing spread across instances
# walks straight through a limit that looks correct in the source.
#
# Leave both empty in development and CI. The in-memory fallback is correct
# there, and a limiter that refused to start without Redis would turn a missing
# variable into a broken first run.
#
# Create at https://console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

node_modules
.next
# Every env file, not just `.env` — a bare `.env` line does not match
# `.env.preview` or `.env.local`, and those hold database connection strings
# for other environments. The template is the one exception and is committed.
.env*
!.env.example
*.tsbuildinfo

# Local-storage-driver uploads (dev only; production uses the S3 driver)
/public/uploads

# Vercel
.vercel

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea
.vscode

# test coverage output
coverage/

# Playwright artifacts — traces, screenshots and error contexts from E2E runs.
# Traces embed request/response bodies and page snapshots from a seeded run;
# they are debugging output, not source, and must not reach the repository.
test-results/
playwright-report/
